{
  "ConnectionStrings": {
    "EmployeeSync": "Server=localhost,1433;Database=EmployeeSync;User Id=sa;Password=YOUR_LOCAL_SA_PASSWORD;TrustServerCertificate=True"
  },
  "TrackTik": {
    "BaseUrl": "https://your-mock-host/prod/v1",
    "TokenUrl": "https://your-mock-host/prod/oauth/token",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "Scope": "",
    "TimeoutSeconds": 15
  },
  "Events": {
    "Mode": "InMemory"
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "Subject": "tracktik.employees.synced"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
