# Local-only values. Copy to .env (untracked) and fill in.
# NEVER commit .env, oauth-credentials.json, or a real client secret.

# Must meet SQL Server complexity rules; set your own strong local password.
# The API container uses the same value in its connection string.
MSSQL_SA_PASSWORD=YOUR_LOCAL_SA_PASSWORD
TRACKTIK_BASE_URL=https://your-mock-host/prod/v1
TRACKTIK_TOKEN_URL=https://your-mock-host/prod/oauth/token
TRACKTIK_CLIENT_ID=YOUR_CLIENT_ID
TRACKTIK_CLIENT_SECRET=YOUR_CLIENT_SECRET
TRACKTIK_SCOPE=

# Consumed by the api service in docker-compose.yml.
EVENTS_MODE=Nats
NATS_URL=nats://nats:4222
NATS_SUBJECT=tracktik.employees.synced
